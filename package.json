{
  "name": "sample-web-app",
  "version": "1.0.0",
  "private": true,
  "description": "Small example Node/TypeScript API used for Vibgrate listing screenshots",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.5",
    "hono": "^4.13.13",
    "ms": "^2.1.3",
    "pino": "^10.4.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
